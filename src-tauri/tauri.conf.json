{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIMBASI BMD",
  "version": "1.0.0",
  "identifier": "com.bpkad.simbasi.bmd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIMBASI BMD — Kota Magelang",
        "width": 1120,
        "height": 720,
        "minWidth": 880,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:5173; script-src 'self' 'unsafe-inline' http://localhost:5173; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; child-src 'self' data: blob:; connect-src 'self' ws://localhost:5173 http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
