{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIM-BA Koreksi BMD",
  "version": "0.1.0",
  "identifier": "com.bpkad.sim-ba-koreksi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIM-BA Koreksi BMD",
        "width": 1024,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "img-src 'self' data:; media-src 'self' data:; child-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
